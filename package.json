{
  "name": "filewi.re",
  "version": "0.2.0",
  "description": "P2P file sharing on the web",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "watchify --verbose -t browserify-livescript -t pugify -o build/index.min.js src/index.ls",
    "start": "lsc server.ls",
    "build": "browserify -t browserify-livescript -t pugify src/index.ls | terser -cm -o build/index.min.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yousefamar/filewi.re.git"
  },
  "keywords": [
    "p2p",
    "file",
    "sharing",
    "torrent",
    "webtorrent",
    "webrtc",
    "transfer",
    "upload",
    "peer"
  ],
  "author": "Yousef Amar <yousef@amar.io> (http://yousefamar.com/)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yousefamar/filewi.re/issues"
  },
  "homepage": "https://github.com/yousefamar/filewi.re#readme",
  "devDependencies": {
    "browserify": "^17.0.1",
    "browserify-livescript": "^0.2.4",
    "d3": "^5.16.0",
    "dropzone": "5.7.0",
    "speedometer": "^1.1.0",
    "watchify": "^4.0.0",
    "webtorrent": "^1.9.7",
    "terser": "^5.44.0",
    "pug": "^3.0.4"
  },
  "dependencies": {
    "express": "^4.21.2",
    "geoip-lite": "^1.4.10",
    "livescript": "^1.6.0",
    "pugify": "^2.2.0"
  },
  "overrides": {
    "pug": "^3.0.4",
    "ip-address": "^10.4.0"
  }
}
